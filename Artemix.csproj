<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- Cible Android (emulateur ou téléphone). Voir README pour ajouter iOS / Windows. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Artemix</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);CS0618;CA1416;XC0022;XC0025</NoWarn>

		<ApplicationTitle>Artemix</ApplicationTitle>
		<ApplicationId>com.artemix.coffrefort</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('-android'))">24.0</SupportedOSPlatformVersion>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#0F4C5C" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0F4C5C" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="SkiaSharp" Version="3.119.0" />
	</ItemGroup>

</Project>
