<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
	x:Class="Artemix.Pages.CategoryPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:c="clr-namespace:Artemix.Controls"
	xmlns:models="clr-namespace:Artemix.Models"
	Shell.NavBarIsVisible="False">

	<Grid>
		<ScrollView>
			<VerticalStackLayout Padding="24,40,24,110" Spacing="0">
				<HorizontalStackLayout Spacing="0">
					<Label Text="←" FontSize="22" Padding="0,0,16,0" VerticalOptions="Center">
						<Label.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnBackTapped" />
						</Label.GestureRecognizers>
					</Label>
					<Label x:Name="TitleLabel" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
				</HorizontalStackLayout>

				<Border Style="{StaticResource Pill}" Margin="0,18,0,0">
					<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
						<Border WidthRequest="16" HeightRequest="16" StrokeThickness="0" VerticalOptions="Center"
								BackgroundColor="{StaticResource Line}" StrokeShape="RoundRectangle 8" />
						<Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Rechercher un document"
							   PlaceholderColor="{StaticResource Muted}" TextColor="{StaticResource Ink}"
							   FontSize="14" BackgroundColor="Transparent" TextChanged="OnSearchChanged" />
					</Grid>
				</Border>

				<Label x:Name="CountLabel" Style="{StaticResource SectionLabel}" Margin="0,16,0,10" />

				<VerticalStackLayout x:Name="DocList" Spacing="8">
					<BindableLayout.ItemTemplate>
						<DataTemplate x:DataType="models:DocumentItem">
							<c:DocRow Mode="File" />
						</DataTemplate>
					</BindableLayout.ItemTemplate>
				</VerticalStackLayout>
			</VerticalStackLayout>
		</ScrollView>

		<Border WidthRequest="56" HeightRequest="56" StrokeThickness="0" BackgroundColor="{StaticResource Amber}"
				StrokeShape="RoundRectangle 28" HorizontalOptions="End" VerticalOptions="End" Margin="0,0,24,24">
			<Border.Shadow>
				<Shadow Brush="Black" Opacity="0.2" Radius="8" Offset="0,3" />
			</Border.Shadow>
			<Label Text="+" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource Teal}"
				   HorizontalOptions="Center" VerticalOptions="Center" />
			<Border.GestureRecognizers>
				<TapGestureRecognizer Tapped="OnAddTapped" />
			</Border.GestureRecognizers>
		</Border>
	</Grid>
</ContentPage>
