<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
	x:Class="Artemix.Pages.SettingsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	Shell.NavBarIsVisible="False">

	<ScrollView>
		<VerticalStackLayout Padding="24,40,24,24" Spacing="0">
			<Label Text="Réglages" FontSize="20" FontAttributes="Bold" />

			<Label Text="Sécurité" Style="{StaticResource SectionLabel}" Margin="0,28,0,10" />
			<Border Style="{StaticResource Card}">
				<VerticalStackLayout>
					<Grid ColumnDefinitions="*,Auto" HeightRequest="56" Padding="16,0">
						<Label Text="Changer le code PIN" FontSize="15" VerticalOptions="Center" />
						<Label Grid.Column="1" Text="›" FontSize="20" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnChangePin" />
						</Grid.GestureRecognizers>
					</Grid>
					<BoxView HeightRequest="1" Color="{StaticResource Line}" />

					<Grid ColumnDefinitions="*,Auto" HeightRequest="56" Padding="16,0">
						<Label Text="Empreinte digitale" FontSize="15" VerticalOptions="Center" />
						<Switch x:Name="BioSwitch" Grid.Column="1" OnColor="{StaticResource Teal}" ThumbColor="White"
								VerticalOptions="Center" Toggled="OnBioToggled" />
					</Grid>
					<BoxView HeightRequest="1" Color="{StaticResource Line}" />

					<Grid ColumnDefinitions="*,Auto" HeightRequest="56" Padding="16,0">
						<Label Text="Verrouillage automatique" FontSize="15" VerticalOptions="Center" />
						<Label x:Name="AutoLockLabel" Grid.Column="1" FontSize="14" TextColor="{StaticResource Muted}"
							   VerticalOptions="Center" />
						<Grid.GestureRecognizers>
							<TapGestureRecognizer Tapped="OnAutoLockTapped" />
						</Grid.GestureRecognizers>
					</Grid>
					<BoxView HeightRequest="1" Color="{StaticResource Line}" />

					<Grid ColumnDefinitions="*,Auto" HeightRequest="56" Padding="16,0">
						<Label Text="Masquer dans les apps récentes" FontSize="15" VerticalOptions="Center" />
						<Switch x:Name="HideSwitch" Grid.Column="1" OnColor="{StaticResource Teal}" ThumbColor="White"
								VerticalOptions="Center" Toggled="OnHideToggled" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<Label Text="À propos" Style="{StaticResource SectionLabel}" Margin="0,28,0,10" />
			<Border Style="{StaticResource Card}" HeightRequest="56" Padding="16,0">
				<Label x:Name="VersionLabel" FontSize="15" VerticalOptions="Center" />
			</Border>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
