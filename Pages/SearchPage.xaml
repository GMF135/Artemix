<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
	x:Class="Artemix.Pages.SearchPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:c="clr-namespace:Artemix.Controls"
	xmlns:models="clr-namespace:Artemix.Models"
	Shell.NavBarIsVisible="False">

	<ScrollView>
		<VerticalStackLayout Padding="24,40,24,24" Spacing="0">
			<Label Text="Recherche" FontSize="20" FontAttributes="Bold" />

			<Border Style="{StaticResource Pill}" Margin="0,16,0,0">
				<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
					<Border WidthRequest="16" HeightRequest="16" StrokeThickness="0" VerticalOptions="Center"
							BackgroundColor="{StaticResource Line}" StrokeShape="RoundRectangle 8" />
					<Entry x:Name="SearchEntry" Grid.Column="1" Placeholder="Rechercher un document"
						   PlaceholderColor="{StaticResource Muted}" TextColor="{StaticResource Ink}"
						   FontSize="14" ReturnType="Search" BackgroundColor="Transparent"
						   TextChanged="OnSearchChanged" />
				</Grid>
			</Border>

			<ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,14,0,0">
				<HorizontalStackLayout x:Name="ChipsRow" Spacing="8" />
			</ScrollView>

			<Label x:Name="CountLabel" Style="{StaticResource SectionLabel}" Margin="0,16,0,10" />

			<VerticalStackLayout x:Name="ResultList" Spacing="8">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="models:DocumentItem">
						<c:DocRow Mode="Type" />
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
